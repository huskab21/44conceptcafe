# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Production domain (used for social share previews)
NEXT_PUBLIC_SITE_URL=https://44hype.mn

# ───── QR menu & table orders ─────
# Staff board (/admin) and QR sheet (/admin/qr) password. REQUIRED — without it nobody can open the board.
ADMIN_KEY=change-me-long-random
# Signs each table's QR link so links can't be guessed. Changing it invalidates printed QR codes.
ORDER_SECRET=change-me-long-random
TABLE_COUNT=12
# Server-only Supabase key (Project Settings → API → secret key) so orders persist. Without it orders are kept in memory (dev only).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# New-order alerts (optional, any combination)
# SMS gateway send URL with {to} and {text} placeholders, + staff numbers
SMS_WEBHOOK_URL=
SMS_TO=
# Telegram bot (free): token from @BotFather, chat id of the staff group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───── Bonum payments (https://psp.bonum.mn/bonum-gateway-apis.html) ─────
# With these set, guests pay through Bonum first; an order only appears on /admin after Bonum confirms payment.
# The money goes to the settlement bank account set on the merchant in the Bonum portal — not configured here.
# Register the webhook URL with Bonum: https://<your-domain>/api/payments/bonum
BONUM_BASE_URL=https://testapi.bonum.mn   # production: https://apis.bonum.mn
BONUM_APP_SECRET=
BONUM_TERMINAL_ID=
BONUM_CHECKSUM_KEY=
